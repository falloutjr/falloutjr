{
  "name": "falloutjr-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "build": "node scripts/build.mjs && node scripts/verify-artifact.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "seed:admin": "node --env-file-if-exists=.env scripts/seed-admin.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "esbuild": "^0.25.12",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "^5.9.3"
  }
}
