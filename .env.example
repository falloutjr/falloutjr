# Local development only. Copy to .env; never commit that file.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_ORIGIN=http://localhost:3000
DATABASE_PATH=.data/falloutjr.sqlite

# Replace this placeholder with a unique password of at least 12 characters.
# Used only by the explicit development seed command, never by automatic startup.
ENABLE_DEV_ADMIN=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Development Admin

# Optional local-only verification/password-recovery mail outbox.
# Contains private, single-use account links; do not enable in production.
DEV_MAIL_OUTBOX=false
DEV_MAIL_OUTBOX_PATH=.data/mail-outbox.ndjson

# Production email delivery: HTTPS endpoint accepting the JSON contract in README.
# Store the token as a hosting secret. No provider is required for public pages.
MAIL_API_URL=
MAIL_API_TOKEN=
MAIL_FROM=

# Optional one-time Worker production provisioning. Configure these ONLY through
# trusted hosting secrets; leave blank for local development. Never put a real
# password, hash, or live expiry in source control. See README for hash generation.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD_HASH=
ADMIN_BOOTSTRAP_EXPIRES=
