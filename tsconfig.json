{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true
  },
  "include": [
    "js/**/*.js",
    "server/**/*.mjs",
    "scripts/**/*.mjs",
    "tests/**/*.mjs"
  ]
}
